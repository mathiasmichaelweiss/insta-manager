# ═══ Основное: маркер доступа Instagram ═══
# Дашборд приложения → "API setup with Instagram business login" → шаг 2
# "Сгенерируйте маркеры доступа" → Generate token. Маркер живёт 60 дней.
# Его же можно просто вставить на странице /settings, тогда сюда писать не нужно.
IG_ACCESS_TOKEN=

# Обычно не нужно — приложение определяет id аккаунта по маркеру.
IG_USER_ID=

# Версия API. Меняйте, если Meta выведет текущую из строя.
GRAPH_API_VERSION=v23.0

# ═══ OpenAI (транскрипция видео) ═══
OPENAI_API_KEY=
# whisper-1 отдаёт таймкоды сегментов; gpt-4o-transcribe точнее, но без сегментов.
OPENAI_TRANSCRIBE_MODEL=whisper-1

# ═══ Необязательно: вход по OAuth вместо ручного маркера ═══
# Instagram login. "ID приложения Instagram" и "Секрет приложения Instagram" из дашборда.
# Внимание: Instagram требует https в Redirect URI, на http://localhost вход не заработает.
IG_APP_ID=
IG_APP_SECRET=

# Facebook login — только если аккаунт связан с Facebook-страницей и вы хотите
# работать через graph.facebook.com.
FB_APP_ID=
FB_APP_SECRET=

# Куда вернуть пользователя после OAuth; этот же URL добавьте в Redirect URI приложения.
APP_BASE_URL=http://localhost:3000

# Куда складывать JSON. По умолчанию ./data
DATA_DIR=
